{
  "name": "dicta-action-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.module.json",
    "check": "prettier --check . && tsc",
    "format": "prettier --write .",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "test:e2e": "npm run build && playwright test",
    "test:llm": "npm run build && node e2e/llm/build-harness.ts && playwright test -c playwright.llm.config.ts",
    "test:harness": "node --test --test-timeout=120000 e2e/harness/check.test.ts e2e/harness/server.test.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "jose": "^6.2.13",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
